@{
    ViewBag.Title = "Home Page";
}

<!-- Simple Bootstrap layout -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2 class="text-center">Employee Management System</h2>
    <p class="text-center text-muted">Manage employees and designations</p>

    <div class="row mt-4">
        <div class="col-md-6">
            <h4>Employee Actions</h4>
            <ul class="list-unstyled">
                <li><a href="@Url.Action("Index", "Employee")">View All Employees</a></li>
                <li><a href="@Url.Action("Create", "Employee")">Add New Employee</a></li>
                <li><a href="@Url.Action("GetCountOnDesignation", "Employee")">Employees Count by Designation</a></li>
                <li><a href="@Url.Action("getEmployeeWithDesignation", "Employee")">Employees with Designation Name</a></li>
                <li><a href="@Url.Action("EmployeeDetailsView", "Employee")">Detailed Employee View</a></li>
                <li><a href="@Url.Action("GetDesignationWithMoreThanOneEmployee", "Employee")">Designations with Multiple Employees</a></li>
                <li><a href="@Url.Action("EmployeeDetailsViewWithDesignation", "Employee")">Employee View with Designation</a></li>
                <li><a href="@Url.Action("GetDesignationId", "Employee")">Find Employees by Designation ID</a></li>
            </ul>
        </div>

        <div class="col-md-6">
            <h4>Designation Actions</h4>
            <ul class="list-unstyled">
                <li><a href="@Url.Action("Index", "Designation")">View All Designations</a></li>
                <li><a href="@Url.Action("Create", "Designation")">Add New Designation</a></li>
            </ul>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
